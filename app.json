{
  "expo": {
    "name": "Bible",
    "slug": "light-bible",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "light-bible",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "android": {
      "backgroundColor": "#000000",
      "package": "com.lightbible.reader",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/withAndroidTheme",
      "./plugins/withAndroidConfigChanges"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0674644d-06a5-44df-b00d-e1b6af597270"
      }
    },
    "owner": "natemollica"
  }
}

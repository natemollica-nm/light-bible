{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "light-bible-api",
  "main": "service.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "RequestBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RequestBudget"] }]
}
